{
	"name": "obsidian-letterboxd-mirror",
	"version": "0.2.0",
	"description": "Sync your Letterboxd diary as notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"test:e2e:watch": "vitest --config vitest.e2e.config.ts",
		"lint": "eslint ./src/",
		"format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"letterboxd",
		"movies",
		"diary"
	],
	"author": "Diego Vicente",
	"license": "MIT",
	"devDependencies": {
		"@eslint/json": "^0.14.0",
		"@types/jsdom": "^27.0.0",
		"@types/node": "^25.0.3",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"builtin-modules": "5.3.0",
		"dotenv": "^17.4.2",
		"esbuild": "0.28.1",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"jsdom": "^27.4.0",
		"obsidian": "latest",
		"prettier": "^3.9.1",
		"tslib": "2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.62.0",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"eta": "^4.6.0"
	}
}
